# Environment variables for streaming Docker containers
# Base paths inside container
BASE_DIR=/app
DATA_DIR=/app/data
RISK_ARTIFACTS=/app/risk_artifacts
SMARTFOLIO_ROOT=/app/SmartFolio

# Kafka brokers (container internal addresses)
KAFKA_BROKER_STOCK=kafka-stock:29092
KAFKA_BROKER_USER=kafka-user:29093

# Kafka topics
STOCK_TOPIC=stock_stream
USER_TOPIC=user_stream

# Producer delays (ms)
PRODUCER_DELAY_STOCK=5
PRODUCER_DELAY_USER=200

# Python path
PYTHONPATH=/app

# Pathway monitoring
PATHWAY_MONITORING=false

# Optional overrides (uncomment to change)
# BASE_DIR=/home/you/INTER_IIT_14
# DATA_DIR=/home/you/INTER_IIT_14/data# =============================================================================
# Environment Configuration for Streaming Pipeline Docker Setup
# =============================================================================

# Kafka Brokers (inside Docker network)
KAFKA_BROKER_STOCK=kafka-stock:29092
KAFKA_BROKER_USER=kafka-user:29093

# Kafka Topics
STOCK_TOPIC=stock_stream
USER_TOPIC=user_stream

# Producer Delays (seconds)
PRODUCER_DELAY_STOCK=5
PRODUCER_DELAY_USER=200

# Paths (inside container)
BASE_DIR=/app
DATA_DIR=/app/data
RISK_ARTIFACTS=/app/risk_artifacts
SMARTFOLIO_ROOT=/app/SmartFolio
OUTPUT_DIR=/app/streaming/output

# Python
PYTHONPATH=/app
PYTHONUNBUFFERED=1
